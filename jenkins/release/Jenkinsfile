// 步驟 12：發版（I 待發版 → J 已發版，或退回 C 待實作）
//
// 手動執行，用參數 MODE 選擇動作：
//   merge    合併：逐張把 I 的單同步最新的基準分支、重新測試，通過就合併進基準分支
//   release  發版：把已合併的單組合成 ChangeLog、決定版號、合併進發版分支並標記版號
// 這個 Job 不負責部署，需要部署時呼叫專案自己的部署 Job。設定方式見 jenkins/README.md。
pipeline {
  agent any
  options {
    disableConcurrentBuilds()
    timeout(time: 240, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '60'))
  }
  stages {
    stage('Checkout') {
      steps {
        script {
          checkout scm
          for (k in ['MODE', 'JIRA_BASE_URL', 'PROJECT_KEY', 'PROJECT_REPO', 'BASE_BRANCH', 'RELEASE_BRANCH']) {
            if (!params[k]) { error "這個 Job 缺少參數：${k}" }
            env."${k}" = params[k]
          }
          if (!(params.MODE in ['merge', 'release'])) { error "MODE 必須是 merge 或 release" }
          if (params.MODE == 'merge') {
            for (k in ['DEPLOY_JOB', 'E2E_BASE_URL']) {
              if (!params[k]) { error "合併需要參數：${k}" }
              env."${k}" = params[k]
            }
          }
          env.DEPLOY_BRANCH_PARAM = params.DEPLOY_BRANCH_PARAM ?: 'BRANCH'
          env.MAX_TICKETS = params.MAX_TICKETS ?: '5'
          if (params.E2E_IMAGE) { env.E2E_IMAGE = params.E2E_IMAGE }
        }
      }
    }
    stage('Run') {
      steps {
        script {
          def creds = [
            usernamePassword(credentialsId: 'jira-api', usernameVariable: 'JIRA_USER', passwordVariable: 'JIRA_TOKEN'),
            usernamePassword(credentialsId: 'github-bot', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')
          ]
          if (params.E2E_ENV_CRED) {
            creds << file(credentialsId: params.E2E_ENV_CRED, variable: 'E2E_ENV_FILE')
          }
          withCredentials(creds) {
            if (params.MODE == 'merge') {
              def out = sh(script: 'bash jenkins/release/run.sh list-merge', returnStdout: true).trim()
              def tickets = out ? out.split('\n').collect { it.trim() }.findAll { it ==~ /[A-Z][A-Z0-9_]*-\d+/ } : []
              if (!tickets) {
                echo '沒有需要合併的單'
                return
              }
              echo "本次合併：${tickets.join(', ')}"
              for (int i = 0; i < tickets.size(); i++) {
                def key = tickets[i]
                try {
                  def rc = sh(script: "bash jenkins/release/run.sh merge-prepare ${key}", returnStatus: true)
                  if (rc == 0) {
                    def dep = build(job: env.DEPLOY_JOB, propagate: false,
                                    parameters: [string(name: env.DEPLOY_BRANCH_PARAM, value: "feature/${key}")])
                    if (dep.result == 'SUCCESS') {
                      sh "bash jenkins/release/run.sh test ${key}"
                    } else {
                      sh "bash jenkins/release/run.sh deploy-failed ${key} '${dep.absoluteUrl}'"
                    }
                  } else if (rc != 10) {
                    error "${key}：準備階段發生未預期的錯誤（代碼 ${rc}）"
                  }
                  sh "bash jenkins/release/run.sh merge-finish ${key}"
                } catch (err) {
                  echo "${key}：合併流程發生錯誤，單子狀態沒有變動：${err}"
                  sh(script: "bash jenkins/release/run.sh unlock ${key}", returnStatus: true)
                  currentBuild.result = 'UNSTABLE'
                }
              }
              // 選用：合併完成後部署基準分支，方便在上面確認整合後的結果
              if (params.BASE_DEPLOY_JOB) {
                def dep = build(job: params.BASE_DEPLOY_JOB, propagate: false,
                                parameters: [string(name: env.DEPLOY_BRANCH_PARAM, value: env.BASE_BRANCH)])
                echo "基準分支部署結果：${dep.result}（${dep.absoluteUrl}）"
              }
            } else {
              def rc = sh(script: 'bash jenkins/release/run.sh release-prepare', returnStatus: true)
              if (rc == 10) {
                echo '沒有可以發版的單'
                return
              }
              if (rc != 0) { error "發版準備失敗（代碼 ${rc}）" }
              if (params.RELEASE_DEPLOY_JOB) {
                def dep = build(job: params.RELEASE_DEPLOY_JOB, propagate: false,
                                parameters: [string(name: env.DEPLOY_BRANCH_PARAM, value: env.RELEASE_BRANCH)])
                if (dep.result == 'SUCCESS') {
                  sh 'bash jenkins/release/run.sh release-finish deployed'
                } else {
                  sh "bash jenkins/release/run.sh release-finish failed '${dep.absoluteUrl}'"
                  error "部署失敗：${dep.absoluteUrl}"
                }
              } else {
                sh 'bash jenkins/release/run.sh release-finish manual'
              }
            }
          }
        }
      }
    }
  }
  post {
    always { archiveArtifacts artifacts: 'work/reports/**', allowEmptyArchive: true }
  }
}
